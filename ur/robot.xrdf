format: "xrdf"

format_version: 2.0

default_joint_positions: 
  shoulder_pan_joint: 0.0018
  shoulder_lift_joint: -0.0003
  elbow_joint: -0.0001
  wrist_1_joint: -0.0
  wrist_2_joint: 0.0
  wrist_3_joint: 0.0017
  palm_finger_1_joint: 0.0173
  palm_finger_2_joint: 0.0173
  finger_1_joint_1: 0.0496
  finger_2_joint_1: 0.0496
  finger_middle_joint_1: 0.0496
  finger_1_joint_2: 0.0
  finger_2_joint_2: 0.0
  finger_middle_joint_2: 0.0
  finger_1_joint_3: -0.0524
  finger_2_joint_3: 0.0524
  finger_middle_joint_3: -0.0524

cspace: 
  joint_names: 
    - "shoulder_pan_joint"
    - "shoulder_lift_joint"
    - "elbow_joint"
    - "wrist_1_joint"
    - "wrist_2_joint"
    - "wrist_3_joint"
  acceleration_limits: [10.0, 10.0, 10.0, 10.0, 10.0, 10.0]
  jerk_limits: [10000.0, 10000.0, 10000.0, 10000.0, 10000.0, 10000.0]
tool_frames: ["wrist_3_link"]
world_collision: 
  geometry: "auto_generated_collision_sphere_group"

self_collision: 
  geometry: "auto_generated_collision_sphere_group"
  ignore: 
    base_link: 
      - "base_link_inertia"
    base_link_inertia: 
      - "shoulder_link"
    shoulder_link: 
      - "upper_arm_link"
    upper_arm_link: 
      - "forearm_link"
    forearm_link: 
      - "wrist_1_link"
    wrist_1_link: 
      - "wrist_2_link"
    wrist_2_link: 
      - "wrist_3_link"
    wrist_3_link: 
      - "palm"
    finger_1_link_0: 
      - "finger_1_link_1"
      - "finger_2_link_0"
      - "finger_middle_link_0"
    finger_1_link_1: 
      - "finger_1_link_2"
    finger_1_link_2: 
      - "finger_1_link_3"
    finger_2_link_0: 
      - "finger_2_link_1"
      - "finger_middle_link_0"
    finger_2_link_1: 
      - "finger_2_link_2"
    finger_2_link_2: 
      - "finger_2_link_3"
    finger_middle_link_0: 
      - "finger_middle_link_1"
    finger_middle_link_1: 
      - "finger_middle_link_2"
    finger_middle_link_2: 
      - "finger_middle_link_3"
    palm: 
      - "finger_1_link_0"
      - "finger_2_link_0"
      - "finger_middle_link_0"

geometry: 
  auto_generated_collision_sphere_group: 
    spheres: 
      Geometry/world/base_link/base_link_inertia/shoulder_link/upper_arm_link/forearm_link/wrist_1_link/wrist_2_link/wrist_3_link: 
