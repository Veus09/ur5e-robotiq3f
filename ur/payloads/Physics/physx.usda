#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.2"
    }
    defaultPrim = "ur"
    doc = """Generated from Composed Stage of root layer /tmp/tmpu_2hnoyg/ur.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_ur_7nuvo6dw/usdex_ur/ur.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_ur_7nuvo6dw/temp_ur/ur.usd


Generated from Composed Stage of root layer /home/vuonggia/ur5eredodo/ur/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "ur"
{
    over "Physics"
    {
        over "shoulder_pan_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 180.00002
        }

        over "shoulder_lift_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 180.00002
        }

        over "elbow_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 180.00002
        }

        over "wrist_1_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 180.00002
        }

        over "wrist_2_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 180.00002
        }

        over "wrist_3_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 180.00002
        }
    }

    over "Geometry"
    {
        over "world" (
            prepend apiSchemas = ["PhysxArticulationAPI"]
        )
        {
            float physxArticulation:sleepThreshold = 0.00005
            int physxArticulation:solverPositionIterationCount = 64
            int physxArticulation:solverVelocityIterationCount = 4
            float physxArticulation:stabilizationThreshold = 0.00001

            over "base_link" (
                prepend apiSchemas = ["PhysicsMassAPI"]
            )
            {
                string isaac:nameOverride (
                    displayName = "Name Override"
                )
                float3 physics:diagonalInertia = (0.004, 0.004, 0.004)
                float physics:mass = 1
            }
        }
    }

    over "robotiq_3f_gripper_articulated"
    {
        over "Geometry" (
            delete apiSchemas = ["PhysicsArticulationRootAPI"]
        )
        {
        }
    }
}

